# ──────────────────────────────────────────────────────────────
# Chatrooms101 — environment reference (copy to .env, fill in)
# ──────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000          # CORS origin

# Postgres (local compose). In prod point at PgBouncer, not RDS directly.
DATABASE_URL=postgresql://chatrooms:chatrooms@localhost:5432/chatrooms?schema=public

# Redis (cache, pub/sub, socket adapter, queues)
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# S3 (local: MinIO from docker-compose; prod: real bucket + IAM role)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatrooms-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Rate limiting
RATE_LIMIT_POINTS=100                  # requests
RATE_LIMIT_WINDOW=60                   # per seconds, per user/IP

# ── Web (Next.js — NEXT_PUBLIC_* is exposed to the browser) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
